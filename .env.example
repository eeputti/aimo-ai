# Valio Aimo Junction 2026 -rajapinnan avain (löytyy Junction-alustalta).
# Ilman avainta hinnat ja saatavuus SIMULOIDAAN ja UI näyttää siitä varoituksen.
VALIO_API_KEY=
VALIO_API_BASE=https://junction26.valioaimo.fi

# Claude API -avain. Ilman avainta reititys ja perustelut tehdään säännöillä (toimii, mutta ei vapaata kieltä).
ANTHROPIC_API_KEY=

# Mallit: syvä agentti = iso malli taustalla, nopea reititin = pieni malli.
DEEP_MODEL=claude-opus-5-5
FAST_MODEL=claude-haiku-5-5

PORT=4747

# Tilausapuri (/assistant.html): Danielin ostosagentti MCP-palvelimena (Render). Vaatii myös ANTHROPIC_API_KEY:n.
# Osoite ilman tokenia; token erikseen (lähetetään Authorization: Bearer -otsakkeessa). Saat molemmat Danielilta.
ASSISTANT_MCP_URL=
ASSISTANT_MCP_TOKEN=

# Keittiödemon erillinen testikanta (oletus data/aimo.db); testit asettavat tämän itse.
# AIMO_DB=/tmp/aimo-kitchen-test.db

# --- Aimo Agent Gateway ---
# Demokello: kiinnittää portin kellon alkamaan tästä hetkestä (Helsingin aikaa). Tarvitaan su 15.11. klo 17.00 jälkeen,
# kun mock-rajapinnan Stock-tuotteiden tilausaika on umpeutunut. Jokainen vastaus ja UI kertoo ajan olevan simuloitu.
# DEMO_NOW=2026-11-14T10:00:00
# Tarjousten allekirjoitusavain (Ed25519, PEM). Jos tyhjä, avain luodaan tiedostoon data/gateway-ed25519.pem.
# GATEWAY_PRIVATE_KEY_PEM=

# --- WhatsApp-testikanava (ks. docs/whatsapp.md) ---
# npm run whatsapp käynnistää erillisen palvelimen ilman paikallista katalogia.
# WHATSAPP_ENABLED=true liittää saman kanavan npm start -palvelimeen (käytä vain yhtä prosessia).
WHATSAPP_ENABLED=false
WHATSAPP_PORT=4748
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
# Itse luotu satunnainen webhookin vahvistustunnus, ei Metan käyttöoikeustoken.
WHATSAPP_VERIFY_TOKEN=
# Aseta Metan sovellukselle tuettu Graph API -versio, esim. v23.0.
WHATSAPP_API_VERSION=
# Oikea ihmisen asiakaspalvelun yhteys (puhelinnumero, sähköposti tai HTTPS-osoite).
WHATSAPP_SUPPORT_CONTACT=
# Pysyvä levy. Oletus data/whatsapp.db; ei GitHubiin.
# WHATSAPP_DB=/var/data/whatsapp.db
# Tilausdemo (ks. docs/whatsapp.md): vain npm run whatsapp. Vaatii omat GATEWAY_DB- ja AIMO_DB-kannat
# (ei data/gateway.db tai data/aimo.db) ja paikallisen katalogin. Oikeaa Valio-tilausta ei lähetetä.
# WHATSAPP_ORDERING_ENABLED=true
# WHATSAPP_DRAFT_DB=/var/data/whatsapp-drafts.db
# WHATSAPP_QUOTE_DB=/var/data/whatsapp-quotes.db
# WHATSAPP_DEMO_PHONE=
# WHATSAPP_DEMO_PERSON=

# --- Tilaussähköpostit (Resend) ---
# Tilausyhteenveto ja tilausvahvistus lähetetään palvelimelta Resendin Email API:lla. Älä talleta avainta Gitiin äläkä lokiin.
# Ilman kaikkia kolmea arvoa sähköpostin lähetys on pois käytöstä (API palauttaa 503) eikä sähköpostia lähde.
# Resendin API-avain (resend.com → API Keys)
RESEND_API_KEY=
# Lähettäjä Resendissä vahvistetulta verkkotunnukselta, esim. orders@example.com tai Valio Aimo <orders@example.com>
ORDER_EMAIL_FROM=
# Palvelimen julkinen HTTPS-osoite ilman polkua tai kyselyä, esim. https://kauppa.example.com. Siitä muodostetaan vahvistuslinkki.
# http://localhost on sallittu vain paikalliseen kokeiluun.
ORDER_EMAIL_PUBLIC_URL=

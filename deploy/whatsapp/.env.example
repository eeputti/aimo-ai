# Copy to deploy/whatsapp/.env; populate privately. Do not copy host database paths here.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
WHATSAPP_SUPPORT_CONTACT=
ANTHROPIC_API_KEY=
FAST_MODEL=claude-haiku-5-5
VALIO_API_KEY=
VALIO_API_BASE=https://junction26.valioaimo.fi
# One verified test recipient; leave blank to pair with the admin invitation command instead.
WHATSAPP_DEMO_PHONE=
WHATSAPP_DEMO_PERSON=
# Optional: the simulated demo clock is shown in the conversation.
# DEMO_NOW=2026-11-14T10:00:00+02:00
# Jatkuvasti päällä olevaan demoon jäädytettyä testirajapintaa vasten: kello kiertää DEMO_NOW:sta ja palaa alkuun
# tämän minuuttimäärän välein, joten su 15.11. klo 17.00 tilausaikaraja ei ylity (9.00 + 420 min = su 9–16).
# DEMO_NOW_LOOP_MINUTES=420
# The container generates an Ed25519 key on its persistent volume when omitted.
# GATEWAY_PRIVATE_KEY_PEM=

# Copy this to .env.coordinator in this directory. Never commit the copy.
# The same TEAM_MCP_DB must be used by the MCP server and coordinator.
# TEAM_MCP_DB=C:/Python/aimo-ai/services/team-mcp/data/team-mcp.db
TEAM_COORDINATOR_PROJECT=aimo-ai
TEAM_COORDINATOR_ID=team-coordinator
TEAM_COORDINATOR_PORT=4752
TEAM_COORDINATOR_MAX_RUNS_PER_HOUR=12
# observe follows events and queues requests without calling a model.
# Switch to openai when your API credentials and model are configured.
TEAM_COORDINATOR_MODE=observe
# OPENAI_API_KEY=
# TEAM_COORDINATOR_MODEL=gpt-4.1-mini
# Optional bounded automatic handoff. All three lists must be set to enable.
# Only [DELEGATE] messages from listed senders may create tasks.
# TEAM_COORDINATOR_WORKERS=aleksi-codex-runner,aleksi-claude-runner
# TEAM_COORDINATOR_DISPATCH_SENDERS=daniel-chatgpt
# TEAM_COORDINATOR_DISPATCH_PATHS=docs,services/team-mcp

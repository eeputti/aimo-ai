# Loopback defaults are for local development only. Everyone in the team needs the same public HTTPS URL.
TEAM_MCP_PORT=4750
TEAM_MCP_HOST=127.0.0.1
TEAM_MCP_PUBLIC_URL=http://127.0.0.1:4750
# Use a persistent private disk for deployment; default is this service's data/team-mcp.db.
# TEAM_MCP_DB=/data/team-mcp.db
# Allowed OAuth callback origins. Loopback HTTP callbacks are also accepted for desktop clients.
TEAM_MCP_REDIRECT_ORIGINS=https://chatgpt.com,https://chat.openai.com,https://claude.ai,https://claude.com
# Hosting providers may set PORT, which takes precedence over TEAM_MCP_PORT.

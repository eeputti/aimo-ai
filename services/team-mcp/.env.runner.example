# Copy to .env.runner only on the machine that will run this CLI worker.
# Create a dedicated member/key on the shared server, then authenticate your CLI locally.
TEAM_RUNNER_URL=https://your-current-tunnel.trycloudflare.com/mcp
TEAM_RUNNER_MEMBER=aleksi-codex-runner
TEAM_RUNNER_KEY=REPLACE_WITH_THIS_MEMBERS_PRIVATE_KEY
TEAM_RUNNER_PROJECT=aimo-ai
TEAM_RUNNER_PROVIDER=codex
TEAM_RUNNER_ACCESS=read-only
TEAM_RUNNER_SENDERS=team-coordinator,daniel-chatgpt
TEAM_RUNNER_PATHS=docs
# Defaults to this clone; use an absolute path when setting these.
# TEAM_RUNNER_REPO=C:/Users/Aleksi/aimo-ai
# TEAM_RUNNER_STATE=C:/Users/Aleksi/aimo-ai/services/team-mcp/data/runner/aleksi-codex-runner
# TEAM_RUNNER_BINARY=C:/path/to/codex.exe
TEAM_RUNNER_TIMEOUT_SECONDS=600
TEAM_RUNNER_POLL_SECONDS=5
